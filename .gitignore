# --------------------
# Model Caches
# --------------------
.fastembed_cache/
*/.fastembed_cache/

# spec-09 live-data harness: cloned real OSS repos + their per-repo analysis and
# the JSON report. Fetched at run time, never committed (override: OPENLORE_LIVE_CACHE_DIR).
.openlore-live-cache/
.kilocode/
.vibe/
result
docker/
docker-compose.yml
# IaC test fixtures are deliberately named docker/ and docker-compose.yml
# (add-docker-container-graph); they must be tracked despite the broad ignores above.
!src/core/analyzer/iac/fixtures/docker/
!src/core/analyzer/iac/fixtures/docker/**
# (ARCHITECTURE.md now lands in .openlore/analysis/ — covered by .openlore/ above — Spec 26 B3)
# openspec: the blanket `openspec/` silently ignored the ADR files written by
# `openlore decisions --sync` (dogfooding, spec 15). Keep ignoring untracked
# analysis artifacts, but un-ignore the authored spec/proposal/decision content
# (specs, changes proposals, ADRs) so new files commit without needing `git add -f`.
openspec/*
!openspec/config.yaml
!openspec/decisions/
!openspec/specs/
!openspec/changes/
.opencode/
.cursorrules
.clinerules/openlore.md
.windsurf/rules.md
.github/copilot-instructions.md
.openlore/decisions/
.clinerules/
