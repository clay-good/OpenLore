    { "kind": "paraphrase", "query": "strip control sequences so a repository cannot forge terminal output", "targets": [{ "name": "sanitizeForTerminal", "file": "src/utils/misc.ts" }] },
    { "kind": "paraphrase", "query": "make sure a joined path stays inside the project root", "targets": [{ "name": "safeJoin", "file": "src/utils/path-confinement.ts" }] },
