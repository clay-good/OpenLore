    { "kind": "paraphrase", "query": "record an architectural decision", "targets": [{ "name": "handleRecordDecision" }] },
    { "kind": "paraphrase", "query": "detect when specifications no longer match the code", "targets": [{ "name": "handleCheckSpecDrift" }] },
    { "kind": "paraphrase", "query": "find unreachable functions that nothing calls", "targets": [{ "name": "handleFindDeadCode" }] },
    { "kind": "paraphrase", "query": "cheapest call route between two functions", "targets": [{ "name": "handleFindPath" }] },
    { "kind": "paraphrase", "query": "files that are usually edited in the same commit", "targets": [{ "name": "analyzeChangeCoupling" }, { "name": "handleGetChangeCoupling" }] },
